---
import Footer from "@components/UI/Footer.astro";
import { ClientRouter } from "astro:transitions";
import Navbar from "@components/UI/react/Navbar";
import "@fontsource/prata";
import "@fontsource/poppins";
import "@fontsource/italiana";
import "@fontsource/pompiere";
import "@fontsource/poiret-one";

interface Props {
  title: string;
}

const { title } = Astro.props;

const Language = Astro.url.pathname.startsWith("/en/");
---

<!doctype html>
<html lang={Language ? "en" : "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Conoce como trasformar tu apariencia y calidad de vida con la mejor especialista que combina tratamientos de vanguardia con técnica y precisión para brindarte resultados excepcionales "
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link
      rel="apple-touch-icon"
      href="/Dra. Pamela especialista en cirugia de cabeza cuello y otorrinolaringologia.png"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="keywords" content="Cirugía, Personalización, Bienestar" />

    <!-- Canonical URL -->
    <link rel="canonical" href="http://www.doctorapamelaperez.com/" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Author -->
    <meta name="author" content="Ecommetrica" />

    <!-- Publisher -->
    <link rel="publisher" href="https://ecommetrica.com" />
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://www.doctorapamelaperez.com/" />
    <meta
      property="og:title"
      content="Descubre la nueva dimensión de belleza con resultados funcionales y naturales."
    />
    <meta
      property="og:description"
      content="Conoce como trasformar tu apariencia y calidad de vida con la mejor especialista que combina tratamientos de vanguardia con técnica y precisión para brindarte resultados excepcionales "
    />
    <meta
      property="og:image"
      content="/Dra. Pamela especialista en cirugia de cabeza cuello y otorrinolaringologia.png"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="http://www.doctorapamelaperez.com/" />
    <meta
      property="twitter:title"
      content="Descubre la nueva dimensión de belleza con resultados funcionales y naturales."
    />
    <meta
      property="twitter:description"
      content="Conoce como trasformar tu apariencia y calidad de vida con la mejor especialista que combina tratamientos de vanguardia con técnica y precisión para brindarte resultados excepcionales "
    />
    <meta
      property="twitter:image"
      content="/Dra. Pamela especialista en cirugia de cabeza cuello y otorrinolaringologia.png"
    />
  </head>
  <body class="overflow-x-hidden">
    <ClientRouter />
    <Navbar client:visible Lang={Language} />
    <slot />
    <Footer Lang={Language} />
  </body>
</html>
<style is:global>
  @import "tailwindcss";

  .font-poiret {
    font-family: "Poiret One", system-ui;
  }
  .font-prata {
    font-family: "Prata", serif;
  }

  .font-poppins {
    font-family: "Poppins", serif;
  }

  .font-pompiere {
    font-family: "Pompiere", serif;
  }

  .font-italiana {
    font-family: "Italiana", serif;
  }

  .font-japandi {
    font-family: "Japandi", serif;
  }

  .font-selna {
    font-family: "Selna", serif;
  }

  .font-selna-oblique {
    font-family: "Selna Oblique", serif;
  }

  .font-selna-outline {
    font-family: "Selna Outline", serif;
  }

  .font-selna-oblique-outline {
    font-family: "Selna Oblique Outline", serif;
  }

  @font-face {
    font-family: "Japandi";
    font-weight: bold;
    src: url("/fonts/Japandi Bold.otf") format("opentype");
  }

  @font-face {
    font-family: "Japandi";
    font-weight: 300; /* Light */
    src: url("/fonts/Japandi Light.otf") format("opentype");
  }

  @font-face {
    font-family: "Japandi";
    font-weight: normal; /* Regular */
    src: url("/fonts/Japandi Regular.otf") format("opentype");
  }

  @font-face {
    font-family: "Selna";
    font-style: oblique;
    src: url("/fonts/Selna-Oblique.otf") format("opentype");
  }

  @font-face {
    font-family: "Selna";
    font-style: oblique;
    src: url("/fonts/Selna-Oblique.ttf") format("truetype");
  }

  @font-face {
    font-family: "Selna";
    font-style: oblique;
    font-weight: 700; /* Outline */
    src: url("/fonts/Selna-ObliqueOutline.otf") format("opentype");
  }

  @font-face {
    font-family: "Selna";
    font-style: oblique;
    font-weight: 700; /* Outline */
    src: url("/fonts/Selna-ObliqueOutline.ttf") format("truetype");
  }

  @font-face {
    font-family: "Selna";
    font-weight: 700; /* Outline */
    src: url("/fonts/Selna-Outline.otf") format("opentype");
  }

  @font-face {
    font-family: "Selna";
    font-weight: 700; /* Outline */
    src: url("/fonts/Selna-Outline.ttf") format("truetype");
  }

  @font-face {
    font-family: "Selna";
    font-weight: normal; /* Regular */
    src: url("/fonts/Selna-Regular.otf") format("opentype");
  }

  @font-face {
    font-family: "Selna";
    font-weight: normal; /* Regular */
    src: url("/fonts/Selna-Regular.ttf") format("truetype");
  }
</style>

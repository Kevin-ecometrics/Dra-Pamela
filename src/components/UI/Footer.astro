---
import { Image } from "astro:assets";
import logo from "@assets/Dra. Pamela especialista en cirugia de cabeza cuello y otorrinolaringologia.png";
import FooterList from "./react/FooterList";

interface Link {
  text: string;
  description: string;
}

const links: Link[] = [
  {
    text: "Sobre Nosotros",
    description:
      "Con una trayectoria dedicada a la cirugía facial y la otorrinolaringología, la Dra. Pamela Pérez se ha destacado por su enfoque cuidadoso y personalizado. Nuestro equipo está comprometido en ofrecer la mejor atención médica, utilizando técnicas avanzadas y un trato humano excepcional.",
  },
  {
    text: "Términos y Servicio",
    description:
      "Nuestros términos y servicios están diseñados para garantizar la mejor experiencia posible para nuestros pacientes. La Dra. Pamela Pérez y su equipo se comprometen a proporcionar servicios médicos de alta calidad, respetando siempre la privacidad y los derechos de nuestros pacientes.",
  },
  {
    text: "Política de Privacidad",
    description:
      "La privacidad de nuestros pacientes es una prioridad para la Dra. Pamela Pérez. Nos aseguramos de que toda la información personal y médica se maneje con la máxima confidencialidad y seguridad, cumpliendo con todas las normativas legales y éticas.",
  },
];

let year = new Date().getFullYear();
---

<footer class="bg-[#798672] font-italiana font-light">
  <div class="w-full px-8 py-4">
    <div
      class="flex justify-center items-center flex-col md:justify-between md:flex-row gap-8 md:gap-2"
    >
      <a href="/" class="cursor-pointer">
        <Image
          title="La Doctora Pamela garantiza procedimientos con enfoque integral en la cirugía facial y otorrinolaringología "
          src={logo}
          alt="La Doctora Pamela garantiza procedimientos con enfoque integral en la cirugía facial y otorrinolaringología "
        />
      </a>
      <FooterList links={links} client:visible />
    </div>
    <div class="py-2">
      <hr />
      <p class="text-center text-white text-lg mt-8">
        Todos los derechos reservados por Dra. Pamela Perez {year} ©.
        <a
          class="hover:underline"
          href="http://www.doctorapamelaperez.com/"
          title="Dra. Pamela Perez | Personalización Absoluta"
          >doctorapamelaperez.com</a
        >
        {" "} está desarrollado por
        <a
          class="hover:underline"
          href="https://ecommetrica.com/"
          title="Ecommetrica | eCommerce meticulously appraised."
        >
          ecommetrica.com
        </a>
      </p>
    </div>
  </div>
</footer>

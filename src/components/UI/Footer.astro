---
import { Image } from "astro:assets";
import logo from "@assets/Dra. Pamela especialista en cirugia de cabeza cuello y otorrinolaringologia.png";
import FooterList from "./react/FooterList";

interface Link {
  text: string;
  description: string;
}

const { Lang } = Astro.props;

const links: Link[] = [
  {
    text: Lang ? "About Us" : "Sobre Nosotros",
    description: Lang
      ? "My commitment to you is transformation beyond the surface, combining technical precision with mindful attention and listening to provide you with exceptional and harmonious results.\nMy goal is to offer cutting-edge aesthetic surgery and non-invasive treatments with the most advanced technology.\nIt will be a pleasure to meet you, listen to you, and work together to make your transformation needs and desires come true."
      : "Mi compromiso contigo es la trasformación más allá de la superficie, combinando la precisión técnica con atención y escucha consciente para brindarte resultados excepcionales y armónicos.\nMi objetivo es ofrecerte una cirugía estética de vanguardia y tratamientos no invasivos con la más avanzada tecnología.\nSera un placer conocerte, escucharte y trabajar juntos para hacer realidad tus necesidades y deseos en tu trasformación.",
  },
  {
    text: Lang ? "Terms and Service" : "Términos y Servicio",
    description: Lang
      ? `The page doctorapamelaperez.com contains direct contact with our customer service staff.\n\nAll reservations made on the page go directly to our reception schedule.\n\nAppointments are confirmed by phone and must be attended by the client within 48 to 24 hours before the appointment.\n\nUnconfirmed appointments may be considered canceled by the client.\n\nAny situation involving changes or refunds must be notified by email to pacientes@doctorapamelaperez.com with a description of the problem or reason for cancellation.`
      : `La página de doctorapamelaperez.com contiene el contacto directo con nuestro personal de atención al cliente.\n\nToda reservación realizada en la página es directa a nuestra agenda en la recepción.\n\nLas citas son confirmadas por teléfono y deberán ser atendidas por el cliente en el periodo de 48hrs a 24hrs antes de la cita.\n\nCitas no confirmadas podrán ser consideradas como canceladas por el cliente.\n\nToda situación que se presente por cambio o devolución deberán ser notificado por correo electrónico a pacientes@doctorapamelaperez.com enviando descripción del problema o razón de la cancelación.`,
  },
  {
    text: Lang ? "Privacy Policy" : "Política de Privacidad",
    description: Lang
      ? "At doctorapamelaperez.com, accessible from http://doctorapamelaperez.com/, your privacy is a top priority. This Privacy Policy explains what information we collect, how we use it, and your rights regarding your data.\n\nInformation We Collect:\n- Personal information you provide directly, such as your name, email, and phone number when you contact us or book an appointment.\n- Technical data automatically collected, such as IP address, browser type, device information, and pages visited, to help us improve our website and services.\n\nHow We Use Your Information:\n- To respond to your inquiries and provide customer support.\n- To manage and confirm appointments.\n- To improve our website, services, and user experience.\n- To send important updates or information related to your care or our services.\n- To comply with legal obligations and prevent fraud.\n\nWe do not sell or share your personal information with third parties except as required by law or to provide our services (for example, with our appointment management provider).\n\nCookies and Analytics:\nWe use cookies and analytics tools to understand how visitors use our site and to enhance your experience. You can control cookie preferences in your browser settings.\n\nYour Rights:\nYou have the right to access, correct, or request deletion of your personal data. To exercise these rights or for any privacy-related questions, please contact us at pacientes@doctorapamelaperez.com.\n\nBy using our website, you agree to this Privacy Policy. We may update this policy; any changes will be posted on this page."
      : "En doctorapamelaperez.com, accesible desde http://doctorapamelaperez.com/, tu privacidad es una prioridad. Esta Política de Privacidad explica qué información recopilamos, cómo la usamos y tus derechos sobre tus datos.\n\nInformación que Recopilamos:\n- Información personal que proporcionas directamente, como nombre, correo electrónico y teléfono al contactarnos o agendar una cita.\n- Datos técnicos recopilados automáticamente, como dirección IP, tipo de navegador, información del dispositivo y páginas visitadas, para ayudarnos a mejorar nuestro sitio y servicios.\n\nCómo Usamos tu Información:\n- Para responder a tus consultas y brindar atención al cliente.\n- Para gestionar y confirmar citas.\n- Para mejorar nuestro sitio web, servicios y experiencia de usuario.\n- Para enviarte actualizaciones importantes o información relacionada con tu atención o nuestros servicios.\n- Para cumplir obligaciones legales y prevenir fraudes.\n\nNo vendemos ni compartimos tu información personal con terceros, salvo que la ley lo requiera o para prestar nuestros servicios (por ejemplo, con nuestro proveedor de gestión de citas).\n\nCookies y Analítica:\nUtilizamos cookies y herramientas de análisis para entender cómo los visitantes usan nuestro sitio y mejorar tu experiencia. Puedes controlar las preferencias de cookies en la configuración de tu navegador.\n\nTus Derechos:\nTienes derecho a acceder, corregir o solicitar la eliminación de tus datos personales. Para ejercer estos derechos o para cualquier consulta sobre privacidad, contáctanos en pacientes@doctorapamelaperez.com.\n\nAl usar nuestro sitio web, aceptas esta Política de Privacidad. Podemos actualizar esta política; cualquier cambio se publicará en esta página.",
  },
];

let year = new Date().getFullYear();
---

<footer class="bg-[#798672] font-italiana font-light">
  <div class="w-full px-8 py-8">
    <div
      class="flex justify-center items-center flex-col md:justify-between md:flex-row gap-8 md:gap-2"
    >
      <a href={Lang ? "/en/" : "/"} class="cursor-pointer">
        <Image
          title={Lang
            ? "Dr. Pamela guarantees procedures with a comprehensive approach in facial surgery and otorhinolaryngology"
            : "La Doctora Pamela garantiza procedimientos con enfoque integral en la cirugía facial y otorrinolaringología "}
          src={logo}
          alt={Lang
            ? "Dr. Pamela guarantees procedures with a comprehensive approach in facial surgery and otorhinolaryngology"
            : "La Doctora Pamela garantiza procedimientos con enfoque integral en la cirugía facial y otorrinolaringología "}
        />
      </a>
      <FooterList links={links} client:visible />
    </div>
    <div class="py-2">
      <hr class="text-white" />
      <p class="text-center text-white text-md mt-8">
        {
          Lang
            ? `All rights reserved by Dr. Pamela Perez ${year} ©.`
            : `Todos los derechos reservados por Dra. Pamela Perez ${year} ©.`
        }
        <a
          class="hover:underline"
          href="http://www.doctorapamelaperez.com/"
          title={Lang
            ? "Dr. Pamela Perez | Absolute Personalization"
            : "Dra. Pamela Perez | Personalización Absoluta"}
        >
          doctorapamelaperez.com
        </a>
        {Lang ? " is developed by " : " está desarrollado por "}
        <a
          class="hover:underline"
          href="https://ecommetrica.com/"
          title="Ecommetrica | eCommerce meticulously appraised."
        >
          ecommetrica.com
        </a>
      </p>
    </div>
  </div>
</footer>

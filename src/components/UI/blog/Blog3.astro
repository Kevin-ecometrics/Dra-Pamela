---

<Image
  class="object-cover absolute translate-x-[1378px] hidden lg:block"
  src={Fondo2}
  alt={texts.backgroundAlt}
/>
<Image
  class="object-cover absolute translate-x-[50px] translate-y-0 z-0 hidden lg:block"
  src={Fondo3}
  alt={texts.backgroundAlt}
/>
<Image
  class="object-cover absolute lg:translate-x-[1410px] translate-y-[900px] hidden lg:block"
  src={Fondo5}
  alt={texts.backgroundAlt}
/>
<Image
  class="object-cover absolute lg:translate-x-0 translate-y-[450px] hidden lg:block"
  src={Fondo8}
  alt={texts.backgroundAlt}
/>
<main class="relative">
  <section class="flex flex-col md:w-[80%] w-full px-8 mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3">
      <div class="col-span-1">
        <Image
          class="z-0 hidden left-0 top-0 absolute lg:block"
          src={Fondo1}
          alt={texts.treatmentsAlt}
          title={texts.treatmentsAlt}
          style="mask-image: linear-gradient(to bottom, black 85%, transparent);"
        />
      </div>
      <div class="col-span-2 font-poppins z-10">
        <h1
          class="text-[#798672] uppercase font-prata font-normal text-center sm:text-xl md:text-4xl lg:text-6xl py-6"
        >
          {title}
        </h1>
        <p class="font-semibold mb-8 text-start">
          {texts.introText}
        </p>

        <p class="text-start mb-8 text-xl text-[#798672] font-bold">
          {texts.hyaluronicTitle}
        </p>
        <p class="font-normal mb-4">
          {texts.hyaluronicText1}
          <br />
          <br />
          {texts.hyaluronicText2}
        </p>

        <p class="font-bold">
          {
            Lang
              ? "The duration of these procedures is 6 to 9 months"
              : "La duración de estos procedimientos es de 6 a 9 meses"
          }
        </p>
        <br />
        <p class="font-bold">
          {
            Lang
              ? "It is an outpatient procedure:"
              : "Es un procedimiento ambulatorio:"
          }
        </p>
        <br />

        <ul class="list-disc pl-4 mb-8">
          <li>
            {
              Lang
                ? "Only follow simple measures such as: Stay as hydrated as possible, avoid hot drinks, lipsticks, and creams."
                : "Solo tomar medidas simples como: Mantente lo más hidratado posible, no te expongas a bebidas calientes, labiales y cremas."
            }
          </li>
          <li>
            {
              Lang
                ? "Avoid exercising for the first 3 days; afterward, it is recommended to avoid high-impact workouts."
                : "Evitar hacer ejercicio los primeros 3 días; posterior a ello, es recomendable no hacer ejercicios de alto impacto."
            }
          </li>
          <li>
            {
              Lang
                ? "If the doctor recommends it, perform massages."
                : "Si la Doctora lo solicita, realizar masajes."
            }
          </li>
        </ul>
      </div>
    </div>
  </section>
  <Image
    class="object-cover absolute lg:translate-x-[-50px] translate-y-[650px] hidden lg:block"
    src={Fondo6}
    alt={texts.backgroundAlt}
  />
  <Image
    class="object-cover absolute lg:translate-x-64 translate-y-[1000px] hidden lg:block rotate-180"
    src={Fondo7}
    alt={texts.backgroundAlt}
  />
  <section class="bg-[#F3EFEF] px-8 font-poppins relative z-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 md:w-[80%] mx-auto">
      <div class="col-span-2 py-8">
        <h1 class="text-[#798672] text-2xl mb-4 font-bold">
          {texts.bioStimulatorsTitle}
        </h1>
        <p class="mb-8">
          {texts.bioStimulatorsText}
        </p>
        <p class="mb-8 font-bold">{texts.benefits}</p>
        <ul class="list-disc pl-4 mb-8">
          <li>{texts.bioBenefit1}</li>
          <li>{texts.bioBenefit2}</li>
          <li>{texts.bioBenefit3}</li>
        </ul>
        <h1 class="font-bold mb-4">{texts.preProcedureTitle}</h1>
        <p class="mb-4">
          {texts.preProcedureText}
        </p>
        <h1 class="font-bold mb-4">{texts.postCareTitle}</h1>
        <ul class="list-disc pl-4 mb-8">
          <li>
            {texts.bioPostCare1}
          </li>
          <li>
            {texts.bioPostCare2}
          </li>
          <li>
            {texts.bioPostCare3}
          </li>
          <li>
            {texts.bioPostCare4}
          </li>
          <li>{texts.bioPostCare5}</li>
          <li>{texts.bioPostCare6}</li>
        </ul>
        <p class="mb-4">
          {texts.followUpText}
        </p>
        <h1 class="mb-4 font-bold">{texts.botoxTitle}</h1>
        <p class="mb-4">
          {texts.botoxText1}
        </p>
        <p class="mb-4">
          {texts.botoxText2}
        </p>
        <h3 class="font-bold mb-4">{texts.applicationZonesTitle}</h3>

        <h4 class="mb-4">
          {texts.applicationZones}
        </h4>

        <h3 class="font-bold mb-4">{texts.botoxPostCareTitle}</h3>

        <h4 class="mb-4">
          {texts.botoxPostCare}
        </h4>

        <h3 class="font-bold mb-4">{texts.resultsTitle}</h3>

        <h4>{texts.resultsText}</h4>
        <br />

        <h3 class="font-bold mb-4">{texts.effectDurationTitle}</h3>
        <h4 class="mb-4">
          {texts.effectDuration}
        </h4>
      </div>
      <div class="col-span-1">
        <Image
          src={Fondo10}
          alt={texts.backgroundAlt}
          class="h-[1100px] hidden lg:block transform scale-x-[-1] absolute right-0"
          style="mask-image: linear-gradient(to bottom, black 85%, transparent);"
        />
      </div>
    </div>
  </section>

  <section class="flex flex-col md:w-[80%] w-full md:px-8 mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 px-8 py-8">
      <div class="col-span-1">
        <Image
          src={Fondo11}
          alt={texts.facialHarmonizationAlt}
          title={texts.facialHarmonizationAlt}
          style="mask-image: linear-gradient(to bottom, black 85%, transparent);"
          class="object-cover absolute left-0 hidden lg:block"
        />
      </div>
      <div class="col-span-2">
        <h1 class="text-[#798672] text-2xl font-bold mb-4">
          {texts.facialHarmonizationTitle}
        </h1>
        <p class="mb-8">
          {texts.facialHarmonizationText1}
          <br />
          {texts.facialHarmonizationText2}
        </p>
        <h3 class="font-bold mb-4">
          {texts.procedureTitle}
        </h3>

        <h4 class="mb-4">
          {texts.procedureText}
        </h4>

        <h3 class="font-bold mb-4">
          {texts.procedureDurationTitle}
        </h3>

        <h4 class="mb-4">
          {texts.procedureDuration}
        </h4>
        <h3 class="font-bold mb-4">
          {texts.harmonizationPostCareTitle}
        </h3>
        <ul class="mb-4">
          <li>
            {texts.harmonizationPostCare1}
          </li>
          <li>
            {texts.harmonizationPostCare2}
          </li>
          <li>
            {texts.harmonizationPostCare3}
          </li>
          <li>
            {texts.harmonizationPostCare4}
          </li>
        </ul>

        <h3 class="font-bold mb-4">
          {texts.harmonizationResultsTitle}
        </h3>

        <h4 class="mb-4">
          {texts.harmonizationResults}
        </h4>
      </div>
    </div>
  </section>
  <section class="bg-[#F3EFEF] px-8 font-poppins">
    <div class="grid grid-cols-1 py-8 lg:grid-cols-3 md:w-[80%] mx-auto">
      <div class="col-span-2">
        <Image
          class="object-cover absolute lg:translate-x-[-200px] translate-y-0 hidden lg:block"
          src={Fondo8}
          alt={texts.backgroundAlt}
        />
        <h1 class="text-[#798672] text-2xl font-bold mb-4">
          {texts.jawProfilingTitle}
        </h1>

        <h3 class="mb-4">
          {texts.jawProfilingText1}
        </h3>

        <h3 class="mb-4">
          {texts.jawProfilingText2}
        </h3>

        <h3 class="font-bold mb-4">
          {texts.jawProcedureDurationTitle}
        </h3>

        <h4 class="mb-4">
          {texts.jawProcedureDuration}
        </h4>

        <h3 class="font-bold mb-4">
          {texts.jawPostCareTitle}
        </h3>

        <h4 class="mb-4">
          {texts.jawPostCare}
        </h4>

        <h3 class="font-bold mb-4">
          {texts.jawResultsTitle}
        </h3>

        <h4 class="mb-4">
          {texts.jawResults}
        </h4>
        <h1 class="text-[#798672] text-2xl font-bold mb-4">
          {texts.nctfTitle}
        </h1>

        <h4 class="mb-4">
          {texts.nctfText}
        </h4>

        <h3 class="mb-4">
          {texts.nctfBenefits}
        </h3>

        <h3 class="font-bold mb-4">
          {texts.nctfProcedureTitle}
        </h3>

        <h4 class="mb-4">
          {texts.nctfProcedure}
        </h4>

        <h1 class="font-bold mb-4">
          {texts.nctfPostCareTitle}
        </h1>

        <h4 class="mb-4">
          {texts.nctfPostCare}
        </h4>

        <h3 class="font-bold mb-4">
          {texts.nctfResultsTitle}
        </h3>

        <h4 class="mb-4">
          {texts.nctfResults}
        </h4>

---
interface Props {
  className: string;
  backgroundImage: string;
}

const { className, backgroundImage } = Astro.props;
---

<section
  style={`background-image: url(${backgroundImage}); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  id="hero-element"
  class={`${className}`}
>
  <slot />
</section>

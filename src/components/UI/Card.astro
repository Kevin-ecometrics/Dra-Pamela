---
const { title, image, titleImage, link } = Astro.props;
import { Image } from "astro:assets";
---

<div
  class="flex flex-col md:flex-row justify-center items-center md:justify-between md:items-center gap-4 border p-4"
>
  <a href={link} class="w-full md:w-1/3">
    <Image
      class="rounded-lg transform transition-transform duration-500 hover:scale-105 w-full md:w-auto"
      src={image}
      title={titleImage}
      alt="Descubre todo lo que necesitas saber sobre la rinoplastia y cómo la Dra. Pamela Pérez realiza este procedimiento con maestría"
    />
  </a>

  <div class="w-full md:w-1/3 text-left">
    <p class="text-lg md:text-2xl font-semibold text-[#6C5545] font-poppins">
      {title}
    </p>
  </div>

  <div class="w-full md:w-1/3 flex justify-start md:justify-end">
    <a
      href={link}
      class="text-[#6C5545] text-lg md:text-2xl font-semibold
      hover:text-white px-4 py-2 transition-colors duration-500 border-2
      hover:bg-[#6C5545] border-[#6C5545] text-center rounded"
    >
      Ver más
    </a>
  </div>
</div>

<style>
  .font-poppins {
    font-family: "Poppins", sans-serif;
  }
</style>

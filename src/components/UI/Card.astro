---
const { title, image, titleImage, link, button } = Astro.props;
import { Image } from "astro:assets";
---

<div
  class="flex flex-col md:flex-row items-center justify-between gap-8 border border-[#798672] rounded-xl p-6 shadow-sm"
>
  <!-- Imagen -->
  <a href={link} class="w-full md:w-1/3 block group">
    <Image
      src={image}
      title={titleImage}
      alt={titleImage}
      class="rounded-xl h-auto w-screen md:w-auto transition-transform duration-500 group-hover:scale-105"
    />
  </a>

  <!-- Título -->
  <div class="w-full md:w-1/3 text-center md:text-left">
    <p
      class="text-xl md:text-2xl font-semibold text-[#6C5545] font-poppins leading-snug"
    >
      {title}
    </p>
  </div>

  <!-- Botón -->
  <div class="w-full md:w-1/3 flex justify-center md:justify-end">
    <a
      href={link}
      class="text-[#6C5545] text-lg md:text-xl font-medium font-poppins border-2 border-[#6C5545] rounded-lg px-5 py-2 transition-all duration-300 hover:bg-[#6C5545] hover:text-white w-screen md:w-auto"
    >
      {button}
    </a>
  </div>
</div>

---
import Card from "@components/UI/Card.astro";
import fotoblog1 from "@assets/blog1.webp";
import fotoblog2 from "@assets/blog2.webp";
import fotoblog3 from "@assets/blog3.webp";
---

<section class="px-8 py-4">
  <div>
    <h1 class="text-[#798672] text-center text-5xl font-prata font-normal mb-4">
      Más información
    </h1>
    <div class="flex flex-col justify-between
     space-y-4 mt-4">
      <Card
        title="Secretos de una Rinoplastia Exitosa."
        image={fotoblog1}
        titleImage="Descubre todo lo que necesitas saber sobre la rinoplastia y cómo la Dra. Pamela Pérez realiza este procedimiento con maestría "
        link="/blog/secretos-de-una-rinoplastia-exitosa/"
      />
      <Card
        title="Mirada Renovada: Blefaroplastia y sus Beneficios "
        image={fotoblog2}
        titleImage="Descubre todo lo que necesitas saber sobre la rinoplastia y cómo la Dra. Pamela Pérez realiza este procedimiento con maestría "
        link="/blog/mirada-renovada-blefaroplastia-y-sus-beneficios/"
      />
      <Card
        title="La Ciencia del Rejuvenecimiento Facial: Tratamientos No Quirúrgicos "
        image={fotoblog3}
        titleImage="Descubre todo lo que necesitas saber sobre la rinoplastia y cómo la Dra. Pamela Pérez realiza este procedimiento con maestría "
        link="/blog/la-ciencia-del-rejuvenecimiento-facial-tratamientos-no-quirurgicos/"
      />
    </div>
  </div>
</section>

<style>
  .font-prata {
    font-family: "Prata", serif;
  }
</style>

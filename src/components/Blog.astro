---
import Card from "@components/UI/Card.astro";
import fotoblog1 from "@assets/blog1.webp";
import fotoblog2 from "@assets/blog2.webp";
import fotoblog3 from "@assets/blog3.webp";

const { Lang } = Astro.props;
---

<section class="px-8 py-4">
  <div>
    <h1 class="text-[#798672] text-center text-5xl font-prata font-normal mb-4">
      {Lang ? "More Information" : "Más información"}
    </h1>

    <div class="flex flex-col justify-between space-y-4 mt-4">
      <Card
        title={Lang
          ? "Secrets of a Successful Rhinoplasty"
          : "Secretos de una Rinoplastia Exitosa."}
        image={fotoblog1}
        titleImage={Lang
          ? "Discover everything you need to know about rhinoplasty and how Dr. Pamela Pérez masterfully performs this procedure."
          : "Descubre todo lo que necesitas saber sobre la rinoplastia y cómo la Dra. Pamela Pérez realiza este procedimiento con maestría "}
        link={Lang
          ? "/en/blog/secretos-de-una-rinoplastia-exitosa/"
          : "/blog/secretos-de-una-rinoplastia-exitosa/"}
      />
      <Card
        title={Lang
          ? "Refreshed Gaze: Blepharoplasty and Its Benefits"
          : "Mirada Renovada: Blefaroplastia y sus Beneficios "}
        image={fotoblog2}
        titleImage={Lang
          ? "Learn how blepharoplasty can rejuvenate your eyes and enhance your appearance with natural-looking results."
          : "Descubre cómo la blefaroplastia puede rejuvenecer tu mirada y realzar tu apariencia con resultados naturales."}
        link={Lang
          ? "/en/blog/mirada-renovada-blefaroplastia-y-sus-beneficios/"
          : "/blog/mirada-renovada-blefaroplastia-y-sus-beneficios/"}
      />
      <Card
        title={Lang
          ? "The Science of Facial Rejuvenation: Non-Surgical Treatments"
          : "La Ciencia del Rejuvenecimiento Facial: Tratamientos No Quirúrgicos "}
        image={fotoblog3}
        titleImage={Lang
          ? "Explore non-invasive options that rejuvenate your skin and facial features with the latest technologies."
          : "Explora opciones no invasivas que rejuvenecen tu piel y rasgos faciales con las tecnologías más avanzadas."}
        link={Lang
          ? "/en/blog/la-ciencia-del-rejuvenecimiento-facial-tratamientos-no-quirurgicos/"
          : "/blog/la-ciencia-del-rejuvenecimiento-facial-tratamientos-no-quirurgicos/"}
      />
    </div>
  </div>
</section>

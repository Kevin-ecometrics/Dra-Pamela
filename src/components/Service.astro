const { serviceName } = Astro.props;

const currentService = services.find(
  (service) =>
    service.title.es.toLowerCase() === serviceName.toLowerCase() ||
    service.title.en.toLowerCase() === serviceName.toLowerCase()
);

if (!currentService) {
  throw new Error(`No service found with name: ${serviceName}`);
}
---

<main class="font-poppins px-4">
  <section class="py-16 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="col-span-2 md:w-[700px] mx-auto">
      <div class="px-4 md:px-0">
        <div class="gap-2 mb-6 flex items-center">
          <Medical />
          <h2 class="text-[#798672] text-3xl font-bold">
            {
              Lang
                ? currentService.procedimiento.en
                : currentService.procedimiento.es
            }
          </h2>
        </div>
        <hr class="w-full border-[#798672] border-2 mb-6" />
        {
          currentService.procedimiento ? (
            <div class="mt-4">
              {currentService.video ? (
                <iframe
                  class="w-full h-96"
                  src={currentService.video}
                  title="YouTube video player"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : null}

              <h2 class="text-lg text-start mb-10 font-selna text-[#AA9170]  ">
                {Lang
                  ? currentService.description.en
                  : currentService.description.es}
              </h2>
              <h1 class="mb-2 text-4xl text-[#AA9170] font-selna">
                {Lang ? currentService.title.en : currentService.title.es}
              </h1>
              <p class="mt-2 font-normal text-lg font-japandi ">
                {Lang
                  ? currentService.videotext.en
                  : currentService.videotext.es}
              </p>
              <p class="mt-2 font-normal text-2xl font-japandi text-[#AA9170]">
                {Lang
                  ? "If you are interested in this procedure, leave me a message or visit my page to make an evaluation appointment with me."
                  : "Si estás interesada en este procedimiento, déjame un mensaje o visita mi página para hacer una cita de evaluación conmigo."}
              </p>
            </div>
          ) : (
            <div>
              <h2 class="text-lg text-start mb-10 font-selna text-[#AA9170]  ">
                {Lang
                  ? "This service does not have a description yet."
                  : "Este servicio aún no tiene descripción."}
              </h2>
            </div>
          )
        }
      </div>
    </div>

    <aside
      class="hidden md:block col-span-1 bg-[#F8F9FC] h-screen border border-gray-300 font-poppins md:h-[850px]"
    >
      <h1
        class="text-center bg-[#6C5545] text-white py-2 font-bold font-poppins uppercase"
      >
        {Lang ? "Services" : "Servicios"}
      </h1>
      <hr class="border-[#798672] w-full border-1" />
      <ul>
        {
          services.map((service) => {
            // Convierte el título a snake_case según el idioma
            const snakeCase = (Lang ? service.title.en : service.title.es)
              .toLowerCase()
              .replace(/ /g, "_");
            // Determina si es el servicio actual (opcional: puedes mejorar la comparación)
            const isActive =
              (Lang
                ? service.title.en.toLowerCase()
                : service.title.es.toLowerCase()) === serviceName.toLowerCase();
            return (
              <li class="mb-4 relative">
                <a
                  class={`font-medium block py-1 w-full text-center group relative ${isActive ? "bg-[#798672] text-white" : ""}`}
                  href={`${Lang ? `/en/services/${snakeCase}/` : `/servicios/${snakeCase}/`}`}
                  style="z-index: 1;"
                >
                  <div
                    class="absolute inset-0 bg-[#798672] transform scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500 ease-in-out"
                    style="z-index: -1;"
                  />
                  <span class="group-hover:text-white">
                    {Lang ? service.title.en : service.title.es}
                  </span>
                </a>
              </li>
            );
          })
        }
        <li class="mb-2 relative">
          <a
            class="font-medium block py-1 w-full text-center group relative"
            href={Lang ? "/en/services/" : "/servicios/"}
            style="z-index: 1;"
          >
            <div
              class="absolute inset-0 bg-[#798672] transform scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500 ease-in-out"
              style="z-index: -1;"
            >
            </div>
            <span class="group-hover:text-white"
              >{Lang ? "Back to services" : "Regresar a los servicios"}</span
            >
          </a>
        </li>
      </ul>
    </aside>
    <div class="block md:hidden px-4">
      <a href={Lang ? "/en/services/" : "/servicios/"}>
        <button
          class="text-white bg-[#6C5545] text-start rounded-3xl py-2 px-4 font-bold"
        >
          {Lang ? "Back to services" : "Regresar a los servicios"}
        </button>
      </a>
    </div>
  </section>
</main>

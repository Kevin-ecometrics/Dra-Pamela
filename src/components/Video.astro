---
import { Image } from "astro:assets";
import { FaInstagram, FaFacebookF, FaTiktok } from "react-icons/fa";

import catalog from "@assets/Antes y despues de una nariz que requeria una modificacion para su correcta funcion.png";
import catalog2 from "@assets/Resultados hermosos de una nariz despues de 3 meses.png";
import catalog3 from "@assets/La Rinoseptumplastia y lipo de cuello proporcionan cambios impresionantes.png";
import Fondo from "@assets/background_image7.png";
import Fondo2 from "@assets/background_image8.png";
import Fondo3 from "@assets/background_image9.png";

const { Lang } = Astro.props;
---

<style>
  body {
    margin: 0;
    text-align: center;
    font-family: "Poppins", sans-serif;
  }

  .container {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 3rem);
    padding: 0.5rem;
  }

  .iphone-case {
    --border-radius-outer: 2rem;
    --outer-padding: 0.5rem;
    --case-color: #000000; /* Nuevo color del caso */
    box-shadow: 0px 0px 0px 2px rgba(0, 0, 0, 0.2); /* Cambio en la sombra */
    background-color: var(--case-color);
    border-radius: var(--border-radius-outer);
    padding: var(--outer-padding);
    width: min(250px);
    aspect-ratio: 1/2;
    position: relative;
    margin-inline: auto;
  }

  .iphone-case > div {
    --start-color: #000;
    --shadow-x: 2px;
    height: 50%;
    border-radius: 50%;
    background-color: var(--base-color, #a7a1a6);
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.2); /* Cambio en la sombra */
    background-size: 100% 200%;
  }

  .iphone-case:before {
    content: "";
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    height: 1.3rem;
    background-color: var(--case-color);
    width: 22%;
    border-radius: 25px;
  }

  .iphone-case.case-2 {
    --border-radius-outer: 2rem;
    --outer-padding: 0.5rem;
    --case-color: #000000; /* Nuevo color del caso */
    box-shadow: 0px 0px 0px 2px rgba(0, 0, 0, 0.2); /* Cambio en la sombra */
    background-color: var(--case-color);
    border-radius: var(--border-radius-outer);
    padding: var(--outer-padding);
    width: min(250px);
    aspect-ratio: 1/2;
    position: relative;
    margin-inline: auto;
  }
</style>

<!-- primera section -->
<div class="grid grid-cols-1 lg:grid-cols-2 py-8 overflow-x-hidden">
  <Image src={Fondo} alt="Catalog" class="rounded-3xl absolute" />

  <div class="iphone-case case-1">
    <video src="/posts.webm" class="h-[500px] rounded-3xl" autoplay muted
    ></video>
  </div>
  <div class="translate-x-80 lg:block hidden">
    <Image
      src={Fondo2}
      alt="Catalog"
      class="rounded-3xl absolute translate-x-[-120px] translate-y-72"
    />
    <Image
      src={Fondo3}
      alt="Catalog"
      class="rounded-3xl absolute translate-x-36 translate-y-40"
    />
    <Image
      src={catalog}
      alt="Un magnífico antes y después de la nariz de una paciente que requería una modificación funcional donde también se logró un realce estético significativo "
      class="rounded-3xl absolute"
    />
    <Image
      src={catalog2}
      alt="Testimonio de una paciente con resultados postoperatorios hermosos y funcionales con apenas 3 meses."
      class="rounded-3xl absolute translate-y-36 translate-x-[-180px]"
    />
    <Image
      src={catalog3}
      alt="Paciente que se le realizó una rinoseptumplastia y lipo de cuello luciendo radiante con los cambios impresionantes  "
      class="rounded-3xl absolute translate-y-72"
    />
  </div>
</div>
<!-- segunda section -->
<!-- Segunda sección -->
<hr />
<div class="grid grid-cols-1 md:grid-cols-2 py-16 mb-16">
  <div class="bg-[#F8F8F8] h-[500px] mt-4 w-full absolute z-0"></div>

  <div class="z-10">
    <h1
      class="font-prata text-center font-normal text-[#798672] text-2xl md:text-4xl py-8 md:py-16"
    >
      {Lang ? "Follow me on social media" : "Sígueme en mis redes sociales"}
    </h1>
    <div class="flex flex-col gap-4 items-center">
      <a
        href="https://www.instagram.com/dra_pamelaperez/"
        target="_blank"
        class="flex justify-center items-center gap-3 mb-6"
      >
        <div class="bg-[#6C5545] p-2 rounded-full">
          <FaInstagram className="text-white text-2xl" />
        </div>
        <p class="prata font-normal text-xl hover:text-[#798672]">
          Dra_Pamela Perez
        </p>
      </a>

      <a
        href="https://www.facebook.com/otorrino.drapamelaperez"
        target="_blank"
        class="flex justify-center items-center gap-3 mb-6"
      >
        <div class="bg-[#6C5545] p-2 rounded-full">
          <FaFacebookF className="text-white text-2xl" />
        </div>
        <p class="prata font-normal text-xl hover:text-[#798672]">
          Dra. Pamela Perez
        </p>
      </a>

      <a
        href="https://www.tiktok.com/@dra_pamelaperez"
        target="_blank"
        class="flex justify-center items-center gap-3 mb-6"
      >
        <div class="bg-[#6C5545] p-2 rounded-full">
          <FaTiktok className="text-white text-2xl" />
        </div>
        <p class="prata font-normal text-xl hover:text-[#798672]">
          @dra_pamelaperez
        </p>
      </a>
    </div>
  </div>

  <div class="iphone-case case-2 py-8 md:py-0">
    <video
      controls
      src="/reel.webm"
      class="h-[500px] rounded-3xl"
      autoplay
      muted></video>
  </div>
</div>

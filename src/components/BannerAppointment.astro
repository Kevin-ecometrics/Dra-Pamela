---
import { Image } from "astro:assets";
import fondo1 from "@assets/background17.png";
import fondo2 from "@assets/background18.png";

const { bg } = Astro.props;
---

<section
  class={`py-16 h-[341px] w-screen ${bg} font-prata text-white relative`}
>
  <Image
    src={fondo1}
    alt="background"
    class="absolute hidden md:block top-0 left-0 object-cover"
  />
  <h1 class="text-center text-5xl mb-8">¿Necesitas una consulta?</h1>
  <h3 class="text-2xl font-medium mb-8 text-center">Agenda en linea.</h3>
  <div class="flex justify-center items-center">
    <a
      href="/appointment"
      class="bg-[#798672] px-8 py-2 font-poppins rounded-2xl"
      >Agenda ahora
    </a>
  </div>
  <Image
    src={fondo2}
    alt="background"
    class="absolute bottom-[-60px] hidden md:block right-0 object-cover"
  />
</section>

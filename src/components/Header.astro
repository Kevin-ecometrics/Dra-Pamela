---
import { Image } from "astro:assets";
import hero from "@assets/Resultados funcionales y esteticos realizados por la Doctora Pamela postoperatorios de los pacientes.png";
import hero2 from "@assets/hero2.png";
import hero3 from "@assets/hero3.png";
import hero4 from "@assets/hero4.png";
import hero5 from "@assets/hero5.png";
import fondo from "@assets/background_image.png";
import fondo2 from "@assets/background_image2.png";
import fondo3 from "@assets/background_image3.png";
import Carrousel from "./UI/react/Carrousel.tsx";

const { Lang } = Astro.props;

const heroImages = [
  {
    src: hero,
    alt: Lang
      ? "Dr. Pamela's results harmonize the facial structure, restore function, and enhance the beauty of her patients."
      : "Los resultados de la Doctora Pamela obtenidos armonizan la estructura facial, dan funcionalidad y realzan la belleza de los pacientes",
    title: Lang
      ? "Dr. Pamela's results harmonize the facial structure, restore function, and enhance the beauty of her patients."
      : "Los resultados de la Doctora Pamela obtenidos armonizan la estructura facial, dan funcionalidad y realzan la belleza de los pacientes",
  },
  {
    src: hero2,
    alt: Lang
      ? "Before and after rhinoplasty by Dr. Pamela Perez."
      : "Antes y después de rinoplastia por la Dra. Pamela Perez.",
    title: Lang
      ? "Before and after rhinoplasty by Dr. Pamela Perez."
      : "Antes y después de rinoplastia por la Dra. Pamela Perez.",
  },
  {
    src: hero3,
    alt: Lang
      ? "Patient profile improved through facial surgery."
      : "Perfil del paciente mejorado mediante cirugía facial.",
    title: Lang
      ? "Patient profile improved through facial surgery."
      : "Perfil del paciente mejorado mediante cirugía facial.",
  },
  {
    src: hero4,
    alt: Lang
      ? "Natural results after nose surgery."
      : "Resultados naturales después de cirugía de nariz.",
    title: Lang
      ? "Natural results after nose surgery."
      : "Resultados naturales después de cirugía de nariz.",
  },
  {
    src: hero5,
    alt: Lang
      ? "Functional and aesthetic recovery by Dr. Pamela."
      : "Recuperación funcional y estética por la Dra. Pamela.",
    title: Lang
      ? "Functional and aesthetic recovery by Dr. Pamela."
      : "Recuperación funcional y estética por la Dra. Pamela.",
  },
];
---

<main class="bg-[#798672] md:h-[500px] text-white h-[800px] relative">
  <section
    class="text-justify items-center px-4 md:px-0 flex py-8 flex-col lg:flex-row"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 px-4">
      <div class="px-4 flex flex-col md:py-24 md:ml-[32%] md:w-[100%]">
        <Image
          src={fondo}
          alt={Lang
            ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
            : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral"}
          title={Lang
            ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
            : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral"}
          class="absolute left-0"
        />
        <span
          class="font-italiana text-5xl text-start md:text-[102px] uppercase"
        >
          {Lang ? "Rhinoplasty" : "Rinoplastia"}
        </span>
        <span class="font-poiret text-3xl mb-2 lg:text-4xl">
          {Lang ? "Total personalization." : "Personalización absoluta."}
        </span>
        <span class="font-poiret md:w-[75%] text-xl lg:text-2xl">
          {
            Lang
              ? "Redefine your facial harmony and highlight your uniqueness with a natural appearance. Refine your profile and achieve nasal aesthetic balance."
              : "Redefine la armonía de tu rostro, resalta tu singularidad con un aspecto natural. Refinamiento del perfil y armonización estética del conjunto nasal."
          }
        </span>
        <Image
          src={fondo2}
          alt={Lang
            ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
            : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral"}
          title={Lang
            ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
            : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral"}
          class="z-10 right-0 top-0 absolute hidden md:block"
        />
        <Image
          src={fondo3}
          alt={Lang
            ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
            : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral"}
          title={Lang
            ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
            : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral"}
          class="z-10 right-32 top-[310px] absolute hidden md:block"
        />
        <Carrousel
          client:only="react"
          images={heroImages}
          className="absolute right-0 bottom-0 md:top-0 md:h-[487px] mask-b-from-80 z-30"
        />
      </div>
    </div>
  </section>
</main>

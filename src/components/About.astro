---
import { Image } from "astro:assets";
import AboutImage from "@assets/Acerca de la Dra. Pamela donde se funciona experiencia tecnica y compromiso con la trasformacion que va mas alla de la superficie.png";
import Fondo from "@assets/background_image4.png";
import Fondo2 from "@assets/background_image5.png";
import Fondo3 from "@assets/background_image6.png";
import AboutLogo from "@assets/about.webp";

const { Lang } = Astro.props;
---

<section class="bg-white flex justify-center">
  <div class="md:w-[1300px] gap-12 grid grid-cols-1 md:grid-cols-2 pt-12">
    <div>
      <Image
        src={AboutImage}
        title={Lang
          ? "Learn more about Dr. Pamela — beyond her experience, she is known for her dedication and artistry in transforming with function and enhancing the beauty of each patient to the next level."
          : "Conoce más acerca de la Dra. Pamela, más allá de su experiencia se destaca por su compromiso y arte en trasformar con funcionalidad realzando la belleza de cada paciente al siguiente nivel"}
        alt={Lang
          ? "Learn more about Dr. Pamela — beyond her experience, she is known for her dedication and artistry in transforming with function and enhancing the beauty of each patient to the next level."
          : "Conoce más acerca de la Dra. Pamela, más allá de su experiencia se destaca por su compromiso y arte en trasformar con funcionalidad realzando la belleza de cada paciente al siguiente nivel"}
        class="flex justify-center items-center"
      />
      <Image
        src={Fondo}
        alt={Lang
          ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
          : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral "}
        title={Lang
          ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
          : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral "}
        class="absolute top-[700px] left-0 hidden md:inline-block"
      />
      <Image
        src={Fondo2}
        alt={Lang
          ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
          : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral "}
        title={Lang
          ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
          : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral "}
        class="absolute top-[700px] right-0 hidden md:inline-block"
      />
      <Image
        src={Fondo3}
        alt={Lang
          ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
          : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral "}
        title={Lang
          ? "Your health in the hands of Dr. Pamela Pérez, a professional who ensures your comprehensive well-being"
          : "Tu salud en manos de Dra. Pamela Pérez una profesional que garantiza tu bienestar integral "}
        class="absolute top-[1300px] left-0 hidden md:inline-block"
      />
    </div>
    <div class="px-4 md:text-start text-center">
      <h1
        class="text-[#798672] text-center md:text-start text-3xl md:text-5xl font-prata"
      >
        Dr{Lang ? "." : "a."} Pamela Perez
      </h1>
      <h2 class="font-poppins font-medium text-[#AA9170] text-lg mb-4">
        {
          Lang
            ? "Redefine your facial harmony and highlight your beauty with a natural look"
            : "Redefine la armonía de tu rostro, resalta tu belleza con un aspecto natural"
        }
      </h2>
      <h3 class="mb-4 font-poppins font-light">
        {
          Lang
            ? `Hello, I'm Dr. Pamela Pérez, a specialist in otolaryngology and head and neck surgery. My commitment to you goes beyond the surface—combining technical precision with conscious care and attentive listening to deliver exceptional and harmonious results. My goal is to provide you with cutting-edge aesthetic surgery and non-invasive treatments using the most advanced technology. It will be a pleasure to meet you, listen to you, and work together to enhance and harmonize your features, taking your natural beauty to the next level.`
            : `Hola, que tal soy la doctora Pamela Pérez especialista en otorrinolaringología y cirugía de cabeza y cuello.   Mi compromiso contigo es la trasformación más allá de la superficie, combinando la precisión técnica con atención y escucha consciente para brindarte resultados excepcionales y armónicos.  Mi objetivo es ofrecerte una cirugía estética de vanguardia y tratamientos no invasivos con la más avanzada tecnología.  Sera un placer conocerte, escucharte y trabajar juntos para realzar y armonizar rasgos de tu rostro llevando tu belleza natural al siguiente nivel.`
        }
      </h3>
      <div class="flex justify-center items-center">
        <Image src={AboutLogo} alt="background" class="hidden md:block" />
      </div>
    </div>
  </div>
</section>

---
import Education from "@components/UI/react/Education";
import Mision from "@components/UI/react/Mision";

const { Lang } = Astro.props;

let education = [
  {
    date: "2011-2018",
    title: Lang ? "General Medicine" : "Medicina General.",
    image: "/education2.webp",
    background: "hover:bg-[#A2948D]",
  },
  {
    date: "2019-2023",
    title: Lang
      ? "Otorhinolaryngology and Head and Neck Surgery"
      : "Otorrinolaringología y Cirugía de Cabeza y Cuello.",
    image: "/education3.webp",
    background: "hover:bg-[#AB9279]",
  },
  {
    date: "2023",
    title: Lang
      ? "Diploma in Rhinology and Facial Plastic Surgery"
      : "Diplomado de Rinología y Cirugía Plástica Facial.",
    image: "/education1.webp",
    background: "hover:bg-[#D9D9D9]",
  },
];

let mision = [
  {
    title: Lang ? "Mission" : "Misión",
    description: Lang
      ? "To provide you with a warm and professional experience that combines aesthetic harmony and functionality, delivering outstanding results that elevate your self-esteem every time you see your reflection. Whether through rhinoplasty or facial surgery, my mission is to help you look and feel your best while respecting your individuality and natural beauty."
      : "Brindarte una experiencia cálida y profesional que combine armonía estética y funcionalidad generando resultados sobresalientes, que eleven tu autoestima cada que veas tu reflejo. Ya sea a través de una rinoplastia o cirugía facial, mi misión es ayudarte a sentirte y verte mejor, respetando tu individualidad y belleza natural.",
    background: "bg-[#D9D9D9]",
    textcolor: "text-[#798672]",
  },
  {
    title: Lang ? "Vision" : "Visión",
    description: Lang
      ? "To become the leading otorhinolaryngologist in Tijuana, backed by a highly qualified team and cutting-edge technology, committed to delivering precise, natural, and exceptional transformations. My approach focuses on ensuring your safety, comfort, and well-being at every stage of the process: before, during, and after your surgery."
      : "Consolidarme como la otorrinolaringóloga de referencia en Tijuana con un equipo altamente calificado con tecnología de vanguardia comprometido a crear cambios excepcionales precisos y naturales. Mi enfoque está en garantizar tu seguridad, comodidad y bienestar en cada etapa del proceso: antes, durante y después de tu cirugía.",
    background: "bg-[#A2948D]",
    textcolor: "text-[#FFFFFF]",
  },
  {
    title: Lang ? "Values" : "Valores",
    description: Lang
      ? "My core values guide every step of my medical practice. Excellence drives the pursuit of outstanding results. Empathy ensures a human, compassionate, and respectful approach to each patient. Integrity commits me to act with honesty and ethics in every clinical decision. "
      : "Mis valores fundamentales guían cada paso de mi práctica médica. La excelencia impulsa la búsqueda constante de resultados sobresalientes. La empatía garantiza un trato humano, cercano y respetuoso con cada paciente. La integridad me compromete a actuar con honestidad y ética en cada decisión clínica. ",
    background: "bg-[#AB9279]",
    textcolor: "text-[#D9D9D9]",
  },
];
---

<section class="px-4 md:px-16 py-8">
  <div class="flex flex-col md:px-20">
    <h1
      class="font-prata text-start px-8 text-3xl md:text-4xl text-[#798672] mb-8"
    >
      {Lang ? "Professional Education" : "Educación Profesional"}
    </h1>
    <Education client:visible education={education} />
    <Mision client:visible mission={mision} />
  </div>
</section>

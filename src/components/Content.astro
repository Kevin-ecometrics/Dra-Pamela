---
import Education from "@components/UI/react/Education";
import Mision from "@components/UI/react/Mision";
import Testimonial from "@components/UI/react/Testimonial";
let education = [
  {
    date: "2011-2018",
    title: "Medicina General.",
    image: "/education2.webp",
  },
  {
    date: "2019-2023",
    title: "Otorrinolaringologia y Cirugia de Cabeza y Cuello.",
    image: "/education3.webp",
  },
  {
    date: "2023",
    title: "Diplomado de Rinologia y Cirugia Plastica Facial.",
    image: "/education1.webp",
  },
];

let mision = [
  {
    title: "Misión",
    background: "bg-[#D9D9D9]",
  },
  {
    title: "Visión",
    background: "bg-[#A2948D]",
  },
  {
    title: "Valores",
    background: "bg-[#AB9279]",
  },
];
---

<section class="px-4 md:px-16 py-8">
  <div class="flex justify-center items-center flex-col md:px-20">
    <h1 class="font-prata text-3xl text-cente md:text-5xl text-[#798672] mb-8">
      Educación Profesional.
    </h1>
    <Education client:visible education={education} />
    <!-- <Mision client:visible mision={mision} /> -->
    <Testimonial client:visible />
  </div>
</section>

<style>
  .font-poppins {
    font-family: "Poppins", sans-serif;
  }
</style>

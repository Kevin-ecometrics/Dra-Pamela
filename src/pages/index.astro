---
import Layout from "@layouts/Layout.astro";
import About from "@components/About.astro";
import Content from "@components/Content.astro";
import Banner from "@components/Banner.astro";
import Contact from "@components/Contact.astro";
import Blog from "@components/Blog.astro";
import Video from "@components/Video.astro";
import Hero from "@components/Header.astro";
import Form from "@components/UI/react/Form";
import BannerAppointment from "@components/BannerAppointment.astro";
import Testimonial from "@components/UI/react/Testimonial";

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout
  title="Descubre la nueva dimensión de belleza con resultados funcionales"
>
  <Hero Lang={Language} />
  <About Lang={Language} />
  <Testimonial client:visible Lang={Language} />
  <Banner Lang={Language} />
  <Video Lang={Language} />
  <Content Lang={Language} />
  <Blog Lang={Language} />
  <BannerAppointment bg="bg-[#AB9279]" Lang={Language} />
  <Form client:visible Lang={Language} />
  <Contact />
</Layout>

---
import Layout from "@layouts/Layout.astro";
import About from "@components/About.astro";
import Content from "@components/Content.astro";
import Banner from "@components/Banner.astro";
import Contact from "@components/Contact.astro";
import Blog from "@components/Blog.astro";
import Video from "@components/Video.astro";
import Hero from "@components/Header.astro";
import Form from "@components/UI/react/Form";
import BannerAppointment from "@components/BannerAppointment.astro";
---

<Layout
  title="Descubre la nueva dimensión de belleza con resultados funcionales"
>
  <Hero />
  <About />
  <Content />
  <Banner />
  <Video />
  <Blog />
  <BannerAppointment bg="bg-[#AB9279]" />
  <Form client:visible />
  <Contact />
</Layout>

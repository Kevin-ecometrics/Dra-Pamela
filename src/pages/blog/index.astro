---
import { changeLanguage } from "i18next";
import Layout from "@layouts/Layout.astro";
import Hero from "@components/UI/blog/Hero.astro";
import Blog from "@components/Blog.astro";
import BannerAppointment from "@components/BannerAppointment.astro";

changeLanguage("es");
---

<Layout
  title="Descubre la nueva dimensión de belleza con resultados funcionales"
>
  <!-- Layout -->
  <main>
    <Hero
      className="bg-[#798672] h-[324px] flex justify-center items-center"
      backgroundImage="/blogHero.webp"
    >
      <h1 class="text-center text-white text-7xl font-prata">Blog</h1>
    </Hero>
    <div class="mb-8"></div>
    <Blog />
    <BannerAppointment bg="bg-[#6C5444]" />
  </main>
</Layout>

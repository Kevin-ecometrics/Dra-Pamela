---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/UI/blog/Hero.astro";
import Blog from "@components/Blog.astro";
import BannerAppointment from "@components/BannerAppointment.astro";

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout
  title="Descubre la nueva dimensión de belleza con resultados funcionales"
>
  <!-- Layout -->
  <main>
    <Hero
      className="bg-[#798672] h-[324px] flex justify-center items-center relative"
      backgroundImage="/banner4.webp"
    >
      <img
        src="/banner_imagen2.webp"
        class="absolute left-0 md:block hidden"
        alt=""
      />
      <h1 class="text-center text-white text-7xl font-prata">Blog</h1>
    </Hero>
    <div class="mb-8"></div>
    <Blog Lang={Language} />
    <BannerAppointment bg="bg-[#6C5444]" Lang={Language} />
  </main>
</Layout>

---
import Hero from "@components/UI/Hero.astro";
import Layout from "@layouts/Layout.astro";
import ServiceComponent from "@components/Service.astro";
import BannerAppointment from "@components/BannerAppointment.astro";

export function getStaticPaths() {
  return [
    { params: { servicio: "rinoseptumplastia_o_rinoplastia" } },
    { params: { servicio: "blefaroplastia" } },
    { params: { servicio: "liposuccion_de_cuello_y_papada" } },
    { params: { servicio: "mentoplastia" } },
    { params: { servicio: "bichectomia" } },
    { params: { servicio: "otoplastia" } },
    { params: { servicio: "levantamiento_de_temporal" } },
    { params: { servicio: "levantamiento_de_cejas" } },
    { params: { servicio: "levantamiento_de_labio" } },
    { params: { servicio: "meloplastia" } },
    { params: { servicio: "aplicacion_de_botox" } },
    { params: { servicio: "acido_hialuronico" } },
    { params: { servicio: "armonizacion_facial" } },
    { params: { servicio: "perfilamiento_mandibular" } },
    { params: { servicio: "tratamiento_en_ojeras" } },
    { params: { servicio: "injerto_con_grasa_o_transferencia_en_rostro" } },
  ];
}
const { servicio } = Astro.params;
const formattedServiceName = servicio
  .split("_")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
---

<Layout title={`Servicio de: ${formattedServiceName}`}>
  <Hero
    backgroundImage="/banner5.webp"
    className="bg-[#798672] h-[324px] flex justify-center items-center relative"
  >
    <img
      src="/banner_imagen1.webp"
      class="absolute left-0 md:block hidden"
      alt=""
    />
    <h1 class="text-center text-white text-4xl md:text-7xl font-prata">
      {formattedServiceName}
    </h1>
  </Hero>
  <ServiceComponent serviceName={formattedServiceName} />
  <BannerAppointment bg="bg-[#A2948D]" />
</Layout>

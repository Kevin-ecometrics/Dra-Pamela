---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/UI/blog/Hero.astro";
import AppoitmentForm from "@components/UI/appointment/AppoitmentForm.astro";

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout
  title="Descubre la nueva dimensión de belleza con resultados funcionales"
>
  <Hero
    backgroundImage="/banner1.webp"
    className="bg-[#798672] h-[324px] flex justify-center items-center relative"
  >
    <img
      src="/banner_imagen4.webp"
      class="absolute left-0 md:block hidden"
      alt=""
    />
    <h1 class="text-center text-white text-7xl font-prata">Agenda tu cita</h1>
  </Hero>
  <div class="mb-8"></div>
  <AppoitmentForm Lang={Language} />
</Layout>

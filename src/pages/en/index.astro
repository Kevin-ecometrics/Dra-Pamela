---
import Layout from "@layouts/Layout.astro";
import About from "@components/About.astro";
import Content from "@components/Content.astro";
import Banner from "@components/Banner.astro";
import Contact from "@components/Contact.astro";
import Blog from "@components/Blog.astro";
import Video from "@components/Video.astro";
import Hero from "@components/Header.astro";
import Form from "@components/UI/react/Form";
import BannerAppointment from "@components/BannerAppointment.astro";

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout title="Discover the new dimension of beauty with functional results">
  <Hero Lang={Language} />
  <About Lang={Language} />
  <Content Lang={Language} />
  <Banner Lang={Language} />
  <Video Lang={Language} />
  <Blog Lang={Language} />
  <BannerAppointment bg="bg-[#AB9279]" Lang={Language} />
  <Form client:visible Lang={Language} />
  <Contact />
</Layout>

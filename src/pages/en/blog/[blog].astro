---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/UI/blog/Hero.astro";
import Blog1 from "@components/UI/blog/Blog1.astro";
import Blog2 from "@components/UI/blog/Blog2.astro";
import Blog3 from "@components/UI/blog/Blog3.astro";

export function getStaticPaths() {
  return [
    { params: { blog: "secrets-of-a-successful-rhinoplasty" } },
    { params: { blog: "refreshed-gaze-blepharoplasty-benefits" } },
    {
      params: {
        blog: "science-of-facial-rejuvenation-non-surgical-treatments",
      },
    },
  ];
}
const { blog } = Astro.params;
const title = blog.replace(/-/g, " ");
---

<Layout title={`Blog: ${title}`}>
  <Hero
    className="bg-[#798672] h-[324px] flex justify-center relative items-center"
    backgroundImage="/banner4.webp"
  >
    <img
      src="/banner_imagen2.webp"
      class="absolute left-0 md:block hidden"
      alt=""
    />
    <h1 class="text-center text-white text-5xl lg:text-7xl font-prata">Blog</h1>
  </Hero>
  {
    blog === "secrets-of-a-successful-rhinoplasty" ? (
      <>
        <Blog1 title={title} />
      </>
    ) : blog === "refreshed-gaze-blepharoplasty-benefits" ? (
      <>
        <Blog2 title={title} />
      </>
    ) : blog === "science-of-facial-rejuvenation-non-surgical-treatments" ? (
      <>
        <Blog3 title={title} />
      </>
    ) : (
      <script>window.location.href = "/404.html";</script>
    )
  }
</Layout>

---
import Layout from "@layouts/Layout.astro";

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout title={Language ? "404 Not Found" : "404 No Encontrado"}>
  <main
    class="bg-[#798672] text-white flex flex-col items-center justify-center h-screen"
  >
    <figure>
      <img
        src="/Dra. Pamela especialista en cirugia de cabeza cuello y otorrinolaringologia.png"
        class="mb-4"
      />
    </figure>

    <p class="text-xl">
      {
        Language
          ? "Sorry, the page you are looking for does not exist."
          : "Lo sentimos, la página que estás buscando no existe."
      }
    </p>
    <a
      href={Language ? "/en/" : "/"}
      class="mt-6 text-white px-8 border border-white py-2 rounded-md hover:bg-white hover:text-[#798672]"
    >
      {Language ? "Return to home page" : "Volver a la página de inicio"}
    </a>
  </main>
</Layout>

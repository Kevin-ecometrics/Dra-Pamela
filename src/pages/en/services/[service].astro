---
import Hero from "@components/UI/Hero.astro";
import Layout from "@layouts/Layout.astro";
import ServiceComponent from "@components/Service.astro";
import BannerAppointment from "@components/BannerAppointment.astro";

export function getStaticPaths() {
  return [
    { params: { service: "rhinoseptoplasty_or_rhinoplasty" } },
    { params: { service: "blepharoplasty" } },
    { params: { service: "neck_and_chin_liposuction" } },
    { params: { service: "mentoplasty" } },
    { params: { service: "buccal_fat_removal" } },
    { params: { service: "otoplasty" } },
    { params: { service: "temporal_lifting" } },
    { params: { service: "brow_lifting" } },
    { params: { service: "lip_lifting" } },
    { params: { service: "meloplasty" } },
    { params: { service: "botox_injection" } },
    { params: { service: "hyaluronic_acid" } },
    { params: { service: "facial_harmonization" } },
    { params: { service: "mandibular_contouring" } },
    { params: { service: "dark_circle_treatment" } },
    { params: { service: "fat_grafting_or_transfer_in_face" } },
  ];
}
const { service } = Astro.params;
const formattedServiceName = service
  .split("_")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout title={`Service: ${formattedServiceName}`}>
  <Hero
    backgroundImage="/serviceHero.webp"
    className="bg-[#798672] h-[324px] flex justify-center items-center"
  >
    <h1 class="text-center text-white text-4xl md:text-7xl font-prata">
      {formattedServiceName}
    </h1>
  </Hero>
  <ServiceComponent serviceName={formattedServiceName} Lang={Language} />
  <BannerAppointment bg="bg-[#A2948D]" />
</Layout>

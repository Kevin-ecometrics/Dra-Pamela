---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/UI/blog/Hero.astro";
import AppoitmentForm from "@components/UI/appointment/AppoitmentForm.astro";

const Language = Astro.url.pathname.startsWith("/en/");
---

<Layout title="Discover a new dimension of beauty with functional results">
  <Hero
    backgroundImage="/banner1.webp"
    className="bg-[#798672] relative h-[324px] flex justify-center items-center"
  >
    <img
      src="/banner_imagen4.webp"
      class="absolute left-0 md:block hidden"
      alt=""
    />

    <h1 class="text-center text-white text-7xl font-prata">
      Book your appointment
    </h1>
  </Hero>
  <div class="mb-8"></div>
  <AppoitmentForm Lang={Language} />
</Layout>

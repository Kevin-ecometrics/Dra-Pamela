---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/UI/Hero.astro";
import Bento from "@components/UI/react/Bento";
import "@fontsource/prata";
import BannerAppointment from "@components/BannerAppointment.astro";
---

<Layout
  title="Descubre la nueva dimensión de belleza con resultados funcionales"
>
  <main>
    <Hero
      backgroundImage="/galleryHero.webp"
      className=" h-[324px] flex justify-center items-center"
    >
      <h1 class="text-center text-white text-7xl font-prata">Galería</h1>
    </Hero>
    <Bento client:visible />
    <BannerAppointment bg="bg-[#6C5444]" />
  </main>
</Layout>
